{
  "name": "tokotachi-designer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "okano-tomoyuki",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/okano-tomoyuki/tokotachi.git",
    "directory": "designer/packages/extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tokotachi",
    "gui",
    "designer",
    "c++"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:json"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "tokotachiDesigner.designer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.ttui.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "tokotachiDesigner.projectEditor",
        "displayName": "%customEditor.project.displayName%",
        "selector": [
          {
            "filenamePattern": "*.ttproj.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "tokotachiDesigner.newWindow",
        "title": "%command.newWindow.title%",
        "category": "Tokotachi Designer",
        "icon": "$(add)"
      },
      {
        "command": "tokotachiDesigner.newComponent",
        "title": "%command.newComponent.title%",
        "category": "Tokotachi Designer"
      },
      {
        "command": "tokotachiDesigner.generateCode",
        "title": "%command.generateCode.title%",
        "category": "Tokotachi Designer",
        "icon": "$(code)"
      },
      {
        "command": "tokotachiDesigner.openAsText",
        "title": "%command.openAsText.title%",
        "category": "Tokotachi Designer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tokotachiDesigner.newProject",
        "title": "%command.newProject.title%",
        "category": "Tokotachi Designer",
        "icon": "$(new-folder)"
      },
      {
        "command": "tokotachiDesigner.generateProject",
        "title": "%command.generateProject.title%",
        "category": "Tokotachi Designer",
        "icon": "$(run-all)"
      },
      {
        "command": "tokotachiDesigner.setMainWindow",
        "title": "%command.setMainWindow.title%",
        "category": "Tokotachi Designer",
        "icon": "$(star-full)"
      },
      {
        "command": "tokotachiDesigner.chooseColorScheme",
        "title": "%command.chooseColorScheme.title%",
        "category": "Tokotachi Designer",
        "icon": "$(color-mode)"
      },
      {
        "command": "tokotachiDesigner.addToProject",
        "title": "%command.addToProject.title%",
        "category": "Tokotachi Designer",
        "icon": "$(add)"
      },
      {
        "command": "tokotachiDesigner.refreshProjects",
        "title": "%command.refreshProjects.title%",
        "category": "Tokotachi Designer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tokotachiDesigner.generateCode",
          "when": "activeCustomEditorId == tokotachiDesigner.designer",
          "group": "navigation"
        },
        {
          "command": "tokotachiDesigner.openAsText",
          "when": "activeCustomEditorId == tokotachiDesigner.designer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "tokotachiDesigner.newProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "tokotachiDesigner.newWindow",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "tokotachiDesigner.newComponent",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "tokotachiDesigner.generateCode",
          "when": "resourceFilename =~ /\\.ttui\\.json$/",
          "group": "navigation@9"
        },
        {
          "command": "tokotachiDesigner.generateProject",
          "when": "resourceFilename =~ /\\.ttproj\\.json$/",
          "group": "navigation@9"
        }
      ],
      "file/newFile": [
        {
          "command": "tokotachiDesigner.newWindow"
        },
        {
          "command": "tokotachiDesigner.newComponent"
        }
      ],
      "view/title": [
        {
          "command": "tokotachiDesigner.newProject",
          "when": "view == tokotachiDesigner.projects",
          "group": "navigation@1"
        },
        {
          "command": "tokotachiDesigner.newWindow",
          "when": "view == tokotachiDesigner.projects",
          "group": "navigation@2"
        },
        {
          "command": "tokotachiDesigner.refreshProjects",
          "when": "view == tokotachiDesigner.projects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "tokotachiDesigner.newWindow",
          "when": "view == tokotachiDesigner.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "tokotachiDesigner.generateProject",
          "when": "view == tokotachiDesigner.projects && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "tokotachiDesigner.newWindow",
          "when": "view == tokotachiDesigner.projects && viewItem == project"
        },
        {
          "command": "tokotachiDesigner.newComponent",
          "when": "view == tokotachiDesigner.projects && viewItem == project"
        },
        {
          "command": "tokotachiDesigner.generateProject",
          "when": "view == tokotachiDesigner.projects && viewItem == project"
        },
        {
          "command": "tokotachiDesigner.chooseColorScheme",
          "when": "view == tokotachiDesigner.projects && viewItem == project"
        },
        {
          "command": "tokotachiDesigner.setMainWindow",
          "when": "view == tokotachiDesigner.projects && viewItem == window.project"
        },
        {
          "command": "tokotachiDesigner.addToProject",
          "when": "view == tokotachiDesigner.projects && viewItem == window.loose"
        },
        {
          "command": "tokotachiDesigner.generateCode",
          "when": "view == tokotachiDesigner.projects && viewItem =~ /^window/"
        }
      ],
      "commandPalette": [
        {
          "command": "tokotachiDesigner.setMainWindow",
          "when": "false"
        },
        {
          "command": "tokotachiDesigner.addToProject",
          "when": "false"
        },
        {
          "command": "tokotachiDesigner.refreshProjects",
          "when": "false"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.ttui.json",
        "url": "./schema/ttui.schema.json"
      },
      {
        "fileMatch": "*.ttproj.json",
        "url": "./schema/ttproj.schema.json"
      }
    ],
    "configuration": {
      "title": "Tokotachi Designer",
      "properties": {
        "tokotachiDesigner.codegen.generateOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.generateOnSave%"
        },
        "tokotachiDesigner.codegen.commentLocale": {
          "type": "string",
          "enum": [
            "en",
            "ja"
          ],
          "default": "en",
          "markdownDescription": "%config.commentLocale%"
        },
        "tokotachiDesigner.codegen.namespace": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.namespace%"
        },
        "tokotachiDesigner.codegen.headerDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.headerDir%"
        },
        "tokotachiDesigner.codegen.sourceDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.sourceDir%"
        },
        "tokotachiDesigner.canvas.colorScheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "markdownDescription": "%config.colorScheme%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokotachiDesigner",
          "title": "%viewContainer.title%",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "tokotachiDesigner": [
        {
          "id": "tokotachiDesigner.projects",
          "name": "%view.projects.name%",
          "icon": "images/activitybar.svg",
          "contextualTitle": "%viewContainer.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tokotachiDesigner.projects",
        "contents": "%view.projects.welcome%"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "vscode:prepublish": "pnpm --filter @tokotachi-designer/webview run build && pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies",
    "generate:schema": "node scripts/generate-json-schema.mts",
    "check:schema": "node scripts/generate-json-schema.mts --check"
  },
  "dependencies": {
    "@tokotachi-designer/canvas": "workspace:*",
    "@tokotachi-designer/codegen": "workspace:*",
    "@tokotachi-designer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  },
  "l10n": "./l10n"
}
