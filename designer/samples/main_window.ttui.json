{
  "format_version": 1,
  "window": {
    "name": "MainWindow",
    "class": "Window",
    "properties": {
      "width": 720,
      "height": 480,
      "title": "ファイルの整理"
    },
    "events": { "on_close": "main_window_close" },
    "menu_bar": {
      "menus": [
        {
          "name": "menu_file",
          "title": "ファイル(&F)",
          "items": [
            { "action": "action_open" },
            {
              "menu": {
                "title": "最近使ったファイル(&R)",
                "items": [{ "action": "action_clear_recent" }]
              }
            },
            { "separator": true },
            { "action": "action_quit" }
          ]
        },
        {
          "title": "表示(&V)",
          "items": [{ "action": "action_details" }]
        }
      ]
    },
    "tool_bar": {
      "properties": {
        "button_style": "TEXT_BESIDE_ICON"
      },
      "items": [
        { "action": "action_open" },
        { "separator": true },
        {
          "widget": {
            "name": "combo_box_view",
            "class": "ComboBox",
            "properties": {
              "items": ["一覧", "詳細"],
              "current_index": 0
            }
          }
        }
      ]
    },
    "status_bar": {
      "properties": {
        "text": "準備ができました"
      },
      "widgets": [
        {
          "name": "label_count",
          "class": "Label",
          "properties": {
            "text": "0 件"
          }
        }
      ]
    },
    "layout": {
      "class": "BoxLayout",
      "properties": {
        "margins": 12
      },
      "items": [
        {
          "widget": {
            "name": "row_search",
            "class": "Widget",
            "layout": {
              "class": "BoxLayout",
              "properties": {
                "orientation": "HORIZONTAL"
              },
              "items": [
                {
                  "stretch": 1,
                  "widget": {
                    "name": "line_edit_search",
                    "class": "LineEdit",
                    "properties": {
                      "placeholder_text": "検索する言葉"
                    },
                    "events": { "on_submit": "search" }
                  }
                },
                {
                  "widget": {
                    "name": "button_search",
                    "class": "Button",
                    "properties": {
                      "text": "検索"
                    },
                    "events": { "on_click": "search" }
                  }
                }
              ]
            }
          }
        },
        {
          "stretch": 1,
          "widget": {
            "name": "splitter_main",
            "class": "Splitter",
            "properties": {
              "sizes": [180, 500]
            },
            "panes": [
              {
                "properties": {
                  "stretch": 0,
                  "collapsible": true
                },
                "widget": {
                  "name": "tree_view_folders",
                  "class": "TreeView"
                }
              },
              {
                "widget": {
                  "name": "tab_widget_files",
                  "class": "TabWidget",
                  "events": { "on_change": "tab_widget_files_change" },
                  "tabs": [
                    {
                      "properties": {
                        "title": "ファイル"
                      },
                      "page": {
                        "name": "list_view_files",
                        "class": "ListView",
                        "properties": {
                          "sorting_enabled": true,
                          "selection_mode": "MULTI"
                        },
                        "events": { "on_activate": "list_view_files_activate" }
                      }
                    },
                    {
                      "name": "tab_detail",
                      "properties": {
                        "title": "詳細",
                        "enabled": false
                      },
                      "page": {
                        "name": "page_detail",
                        "class": "Widget",
                        "layout": {
                          "class": "GridLayout",
                          "properties": {
                            "margins": { "left": 8, "top": 8, "right": 8, "bottom": 8 }
                          },
                          "columns": {
                            "1": { "stretch": 1 }
                          },
                          "items": [
                            {
                              "row": 0,
                              "column": 0,
                              "widget": {
                                "name": "label_name",
                                "class": "Label",
                                "properties": {
                                  "text": "名前"
                                }
                              }
                            },
                            {
                              "row": 0,
                              "column": 1,
                              "widget": {
                                "name": "line_edit_name",
                                "class": "LineEdit"
                              }
                            },
                            {
                              "row": 1,
                              "column": 0,
                              "widget": {
                                "name": "label_size",
                                "class": "Label",
                                "properties": {
                                  "text": "大きさ",
                                  "color": "TEXT_SECONDARY"
                                }
                              }
                            },
                            {
                              "row": 1,
                              "column": 1,
                              "horizontal": "START",
                              "widget": {
                                "name": "spin_box_size",
                                "class": "SpinBox",
                                "properties": {
                                  "maximum": 1000,
                                  "value": 10
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "widget": {
            "name": "row_buttons",
            "class": "Widget",
            "layout": {
              "class": "BoxLayout",
              "properties": {
                "orientation": "HORIZONTAL"
              },
              "items": [
                {
                  "widget": {
                    "name": "check_box_hidden",
                    "class": "CheckBox",
                    "properties": {
                      "text": "隠しファイルも表示する"
                    }
                  }
                },
                { "stretch": 1 },
                {
                  "widget": {
                    "name": "button_close",
                    "class": "Button",
                    "properties": {
                      "text": "閉じる",
                      "style": "SECONDARY"
                    },
                    "events": { "on_click": "button_close_click" },
                    "actions": ["action_quit"]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "actions": [
    {
      "name": "action_open",
      "properties": {
        "text": "開く(&O)...",
        "shortcut": "Ctrl+O"
      },
      "events": { "on_trigger": "action_open_trigger" }
    },
    {
      "name": "action_clear_recent",
      "properties": {
        "text": "一覧を消す(&C)"
      }
    },
    {
      "name": "action_details",
      "properties": {
        "text": "詳細を表示(&D)",
        "checkable": true,
        "checked": true
      }
    },
    {
      "name": "action_quit",
      "properties": {
        "text": "終了(&X)",
        "shortcut": "Ctrl+Q"
      },
      "events": { "on_trigger": "action_quit_trigger" }
    }
  ],
  "objects": [
    {
      "name": "timer_refresh",
      "class": "Timer",
      "properties": {
        "interval": 5000
      },
      "events": { "on_timer": "refresh" }
    }
  ]
}
