{
  "format_version": 1,
  "window": {
    "name": "SettingsDialog",
    "class": "Dialog",
    "properties": {
      "minimum_size": { "width": 400 },
      "title": "設定"
    },
    "events": { "on_finish": "settings_finish" },
    "layout": {
      "class": "BoxLayout",
      "properties": {
        "margins": 16,
        "spacing": 12
      },
      "items": [
        {
          "widget": {
            "name": "heading",
            "class": "Label",
            "properties": {
              "text": "表示の設定",
              "font": { "size": 18 },
              "color": "#3366CC"
            }
          }
        },
        { "spacing": 4 },
        {
          "stretch": 1,
          "widget": {
            "name": "scroll",
            "class": "ScrollArea",
            "properties": {
              "minimum_size": { "height": 120 },
              "fit_width": true
            },
            "content": {
              "name": "badge_area",
              "class": "Widget",
              "properties": {
                "minimum_size": { "width": 200, "height": 160 }
              },
              "layout": {
                "class": "PlaceLayout",
                "items": [
                  {
                    "placement": { "relative_x": 0.5, "relative_y": 0.5, "anchor": "CENTER" },
                    "widget": {
                      "name": "badge",
                      "class": "Label",
                      "properties": {
                        "text": "中央"
                      }
                    }
                  },
                  {
                    "placement": { "x": -8, "y": 8, "relative_x": 1, "anchor": "TOP_RIGHT" },
                    "widget": {
                      "name": "corner_check",
                      "class": "CheckBox",
                      "properties": {
                        "text": "右上"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "widget": {
            "name": "free_area",
            "class": "Widget",
            "properties": {
              "minimum_size": { "height": 48 }
            },
            "children": [
              {
                "name": "zoom_slider",
                "class": "Slider",
                "properties": {
                  "x": 0,
                  "y": 8,
                  "width": 200,
                  "height": 32,
                  "maximum": 200,
                  "value": 100
                },
                "events": { "on_change": "zoom_change" }
              },
              {
                "name": "zoom_bar",
                "class": "ProgressBar",
                "properties": {
                  "x": 216,
                  "y": 16,
                  "width": 160,
                  "height": 16,
                  "maximum": 200,
                  "value": 100
                }
              }
            ]
          }
        }
      ]
    },
    "buttons": [{ "button": "OK" }, { "button": "CANCEL", "text": "やめる" }]
  }
}
