{
  "format_version": 1,
  "window": {
    "name": "LabeledEdit",
    "class": "Widget",
    "properties": {
      "width": 360,
      "height": 40
    },
    "layout": {
      "class": "BoxLayout",
      "properties": {
        "orientation": "HORIZONTAL"
      },
      "items": [
        {
          "widget": {
            "name": "label_caption",
            "class": "Label",
            "properties": {
              "text": "名前"
            }
          }
        },
        {
          "stretch": 1,
          "widget": {
            "name": "line_edit_value",
            "class": "LineEdit",
            "events": { "on_change": "value_change" }
          }
        }
      ]
    }
  }
}
