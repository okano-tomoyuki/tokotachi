{
  "name": "tokotachi-designer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @tokotachi-designer/cli run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tools",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm catalog:check && pnpm test",
    "catalog:extract": "node tools/catalog/extract.mts",
    "catalog:check": "node tools/catalog/extract.mts --check",
    "codegen:verify-cpp": "node tools/codegen/verify-cpp.mts",
    "codegen:golden": "node tools/codegen/golden.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tokotachi-designer/codegen": "workspace:*",
    "@tokotachi-designer/core": "workspace:*",
    "@types/node": "^24.13.6",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
