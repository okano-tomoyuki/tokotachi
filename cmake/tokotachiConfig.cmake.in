# find_package(tokotachi) で読まれる設定(docs/adr/0037)。
#
#   find_package(tokotachi 0.1 REQUIRED)
#   target_link_libraries(app PRIVATE tokotachi::tokotachi)
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/tokotachiTargets.cmake")
# C API(tokotachi::tokotachi_c。docs/adr/0041)は、作ってインストールしたときだけある。
include("${CMAKE_CURRENT_LIST_DIR}/tokotachi_cTargets.cmake" OPTIONAL)

# 共有ライブラリか静的ライブラリか(TRUE なら共有)。
set(tokotachi_SHARED @TOKOTACHI_SHARED@)

check_required_components(tokotachi)
